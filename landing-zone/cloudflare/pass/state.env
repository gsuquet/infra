# Proton Pass references (pass://<vault>/<item>/<field>), resolved by `pass-cli run`. No secret here.
# R2 S3 token scoped to the state bucket: access key = token ID, secret = SHA-256 of the token value.
AWS_ACCESS_KEY_ID=pass://personal/cloudflare/state-access-key-id
AWS_SECRET_ACCESS_KEY=pass://personal/cloudflare/state-access-key-secret
AWS_ENDPOINT_URL_S3=pass://personal/cloudflare/state-endpoint-url
