{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "commitBodyTable": true,
  "configMigration": true,
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "opentofu",
      "description": "OpenTofu CLI pin in language.compatible_with: the terraform manager does not read the language block",
      "extractVersionTemplate": "^v(?<version>\\S+)$",
      "managerFilePatterns": [
        "**/*.tf",
        "**/*.tofu"
      ],
      "matchStrings": [
        "compatible_with\\s*\\{\\s*opentofu\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "packageNameTemplate": "opentofu/opentofu"
    }
  ],
  "description": "Renovate config for the infra repo. Every dependency is pinned exactly (versions, commit SHAs with '# frozen: <tag>'). Nothing merges itself: no CI is a required status check yet.",
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver",
    ":enablePreCommit",
    ":gitSignOff",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":semanticCommitScope(deps)"
  ],
  "internalChecksFilter": "strict",
  "labels": [
    "renovate"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-6 * * 1"
    ]
  },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "dependencyDashboardApproval": true,
      "description": "Major updates wait for approval on the Dependency Dashboard",
      "matchUpdateTypes": [
        "major"
      ]
    },
    {
      "description": "Dev tools (mise, pre-commit, GitHub Actions): one weekly PR. TODO: automerge once CI is a required status check",
      "groupName": "dev tools",
      "groupSlug": "dev-tools",
      "matchManagers": [
        "mise",
        "pre-commit",
        "github-actions"
      ],
      "semanticCommitScope": "tools"
    },
    {
      "description": "OpenTofu CLI: the mise tool and every language.compatible_with pin move together (exact pins must match)",
      "groupName": "opentofu cli",
      "groupSlug": "opentofu-cli",
      "matchPackageNames": [
        "opentofu",
        "opentofu/opentofu"
      ],
      "semanticCommitScope": "opentofu"
    },
    {
      "description": "OpenTofu providers: root and child modules pin the same exact version, so one PR updates them all; review the plan before merging",
      "groupName": "opentofu providers",
      "groupSlug": "opentofu-providers",
      "matchDepTypes": [
        "provider",
        "required_provider"
      ],
      "matchManagers": [
        "terraform"
      ],
      "semanticCommitScope": "opentofu"
    },
    {
      "description": "Look providers and modules up in the OpenTofu registry, the one tofu init uses and the lock files name",
      "matchDatasources": [
        "terraform-module",
        "terraform-provider"
      ],
      "registryUrls": [
        "https://registry.opentofu.org"
      ]
    },
    {
      "description": "Lock file maintenance PRs use the lock scope",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "semanticCommitScope": "lock"
    }
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "rangeStrategy": "pin",
  "schedule": [
    "* 0-6 * * 1"
  ],
  "timezone": "Europe/Paris",
  "vulnerabilityAlerts": {
    "labels": [
      "renovate",
      "security"
    ],
    "minimumReleaseAge": null,
    "schedule": [
      "at any time"
    ]
  }
}
