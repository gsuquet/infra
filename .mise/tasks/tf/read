#!/usr/bin/env bash
#MISE description="Run OpenTofu (tofu) in landing-zone/cloudflare with the read-only token; use with plan -lock=false"
#MISE dir="{{config_root}}/landing-zone/cloudflare"
# OpenTofu with credentials resolved from Proton Pass for this process only (`mise run tf:read plan -lock=false`).
set -euo pipefail

exec pass-cli run --env-file pass/read.env --env-file pass/state.env -- tofu "$@"
